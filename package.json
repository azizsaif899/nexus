{
  "name": "g-assistant-nx",
  "version": "2.4.0",
  "license": "MIT",
  "scripts": {
    "deploy:google": "node scripts/deploy-google.js",
    "deploy:firebase": "firebase deploy",
    "build:prod": "npm run build && npm run deploy:firebase",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "serve": "nx run-many -t serve",
    "format": "nx format:write",
    "dev": "nx run-many -t serve --parallel=3",
    "dev:web-chatbot": "nx serve web-chatbot",
    "dev:admin-dashboard": "nx serve admin-dashboard",
    "dev:api": "nx serve api",
    "dev:nexus-ai-main": "npx kill-port 3000 && cd apps/nexus-ai-main && npx vite --port 3000 --host",
    "start:nexus": "npx kill-port 3000 && cd apps/nexus-ai-main && npx vite --port 3000 --host",
    "nexus": "npx kill-port 3000 && cd apps/nexus-ai-main && npx vite --port 3000 --host",
    "server": "npx kill-port 3000 && cd apps/nexus-ai-main && npx vite --port 3000 --host",
    "dev:all": "nx run-many -t serve --parallel=5",
    "clean": "nx reset && rm -rf node_modules",
    "security:audit": "npm audit",
    "security:check": "node -e \"console.log('🔒 Security check: OK')\"",
    "env:check": "node -e \"if(!require('fs').existsSync('.env')){console.error('❌ .env file missing! Copy from .env.example');process.exit(1)}else{console.log('✅ .env file found')}\"",
    "setup:dev": "npm run env:check && npm install && npm run test:quick",
    "test:quick": "vitest tests/unit/sidebar-agents.test.ts",
    "setup:firebase": "npm install -g firebase-tools && firebase login && firebase init",
    "setup:tenant": "node scripts/setup-tenant-system.js"
  },
