rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // المستخدمون يمكنهم قراءة وتعديل بياناتهم فقط
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // بيانات الشركات - فقط المستخدمين المنتمين لها
    match /tenant_data/{tenantId}/{document=**} {
      allow read, write: if request.auth != null 
        && getUserTenant(request.auth.uid) == tenantId;
    }
    
    // معلومات الشركة - فقط أعضاؤها
    match /tenants/{tenantId} {
      allow read: if request.auth != null 
        && getUserTenant(request.auth.uid) == tenantId;
      allow write: if request.auth != null 
        && getUserRole(request.auth.uid) in ['owner', 'admin'];
    }
    
    // الاشتراكات - فقط المالك والأدمن
    match /subscriptions/{tenantId} {
      allow read, write: if request.auth != null 
        && getUserTenant(request.auth.uid) == tenantId
        && getUserRole(request.auth.uid) in ['owner', 'admin'];
    }
    
    // الاستخدام - قراءة فقط
    match /usage/{tenantId} {
      allow read: if request.auth != null 
        && getUserTenant(request.auth.uid) == tenantId;
    }
    
    // الدعوات - فقط الأدمن
    match /invitations/{inviteId} {
      allow read, write: if request.auth != null 
        && getUserRole(request.auth.uid) in ['owner', 'admin'];
    }
    
    // Functions للتحقق من البيانات
    function getUserTenant(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.tenantId;
    }
    
    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
  }
}