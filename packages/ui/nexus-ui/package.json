{
  "name": "@nexus/ui",
  "version": "1.0.0",
  "description": "Nexus Design System - Shared Colors, Themes & Components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "styles"],
  "scripts": {
    "build": "tsc && cp -r styles dist/",
    "dev": "tsc --watch"
  },
  "exports": {
    ".": "./dist/index.js",
    "./styles": "./styles/globals.css",
    "./colors": "./dist/colors.js",
    "./theme": "./dist/theme.js"
  }
}