{
  "name": "visual-workflow-automation-vite",
  "version": "3.3.0",
  "description": "نظام الأتمتة المرئية الاحترافي - Professional Visual Workflow Automation System with Vite + React 19",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4100 --host",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4200 --host",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules dist package-lock.json",
    "fresh-install": "npm run clean && npm cache clean --force && npm install",
    "fix:imports": "node fix-imports.js",
    "fix:all": "npm run fix:imports && npm install",
    "verify": "npm run type-check && npm run lint && npm run build"
  },
