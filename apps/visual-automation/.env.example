# ActivePieces Configuration
# Copy this file to .env.local and fill in your values

# ActivePieces API Configuration
VITE_ACTIVEPIECES_API_URL=http://localhost:8080/api/v1
VITE_ACTIVEPIECES_API_KEY=your_api_key_here
VITE_ACTIVEPIECES_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks
VITE_ACTIVEPIECES_FRONTEND_URL=http://localhost:8080

# Production Example (uncomment and modify):
# VITE_ACTIVEPIECES_API_URL=https://your-instance.activepieces.com/api/v1
# VITE_ACTIVEPIECES_API_KEY=ap_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_ACTIVEPIECES_WEBHOOK_URL=https://your-instance.activepieces.com/api/v1/webhooks
# VITE_ACTIVEPIECES_FRONTEND_URL=https://your-instance.activepieces.com