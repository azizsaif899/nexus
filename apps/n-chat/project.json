{
  "name": "n-chat",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/n-chat/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/n-chat"
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "n-chat:build",
        "dev": true,
        "port": 3003
      },
      "configurations": {
        "development": {
          "buildTarget": "n-chat:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "n-chat:build:production",
          "hmr": false
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "n-chat:build:production"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/n-chat"],
      "options": {
        "jestConfig": "apps/n-chat/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/next:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/n-chat/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": []
}
