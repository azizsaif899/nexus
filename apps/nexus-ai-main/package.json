{
  "name": "nexus-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nexus AI - Modern AI/Automation Gateway Platform with Arabic & English Support",
  "author": "Nexus AI Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start-dev.js",
    "manager": "node scripts/nexus-manager.js",
    "kill-port": "node scripts/kill-port.js",
    "check-port": "node scripts/check-port.js",
    "clear-cache": "node scripts/clear-cache.js",
    "build": "npm run type-check && vite build",
    "build:analyze": "npm run build && npx vite-bundle-analyzer dist/stats.html",
    "build:performance": "vite build --config vite.config.performance.ts && npm run lighthouse",
    "dev:performance": "vite --config vite.config.performance.ts --port 3000 --host",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && echo '✅ TypeScript validation passed!'",
    "check:compatibility": "node scripts/check-browser-compatibility.js",
    "check:browsers": "npx browserslist",
    "lighthouse": "lighthouse http://localhost:4173 --output-path=./lighthouse-report.html --output=html --chrome-flags='--headless'",
    "serve:optimized": "npm run build && npm run preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.18.0",
    "lucide-react": "^0.487.0",
    "motion": "^11.15.0",
    "react": "^19.1.1",
    "react-day-picker": "^9.11.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.64.0",
    "react-router-dom": "^7.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^4.0.12",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cssnano": "^7.0.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.4.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^6.0.5",
    "vite-bundle-analyzer": "^0.12.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
